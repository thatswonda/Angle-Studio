# API keys stay on the server and are never sent to the browser.
# A model only shows up in the top-bar selectors when its provider key is set.

# Google AI Studio key: Gemini video analysis, Gemini TTS, Nano Banana / Imagen, Veo
GEMINI_API_KEY=
# Google Cloud key with the YouTube Data API v3 enabled: video stats and comments
YOUTUBE_API_KEY=
# platform.openai.com: ChatGPT (GPT-5.5) writes the angles, the story and metadata
OPENAI_API_KEY=
# Which model writes. Set to claude-opus-5-5 (or claude-sonnet-5-5) to switch to Claude.
ANGLE_STUDIO_WRITER=gpt-5-5
# Later, to use Claude instead: console.anthropic.com
ANTHROPIC_API_KEY=
# Higgsfield API (prepaid balance, separate from Higgsfield plans): Seedance 2.0, Kling 3.0
HIGGSFIELD_API_KEY=
# Optional: only needed to clone your own voice
ELEVENLABS_API_KEY=

# Where project folders (JSON + media) are written.
ANGLE_STUDIO_DATA=./data
# Ask before a project spends more than this (USD).
ANGLE_STUDIO_COST_LIMIT=10.00
# Set to 1 to use mock adapters for every capability, even when keys are present.
ANGLE_STUDIO_MOCK=1
